# Environment variables read by the plugin's env layer (plugin/config/resolveEnv.ts).
# All are optional; the defaults below are applied when unset.
# Vars must carry the configured env prefix (default: VITE_).

# Base public path for the app. Default: /
#VITE_BASE_URL=/

# Public origin used when composing absolute URLs (e.g. for SSG). Default: empty
#VITE_PUBLIC_ORIGIN=

# Mode; inferred from the vite command / NODE_ENV when unset.
#VITE_MODE=development

# Derived from mode when unset.
#VITE_DEV=true
#VITE_PROD=false

# Whether the process runs under the react-server condition; auto-detected.
#VITE_SSR=false
