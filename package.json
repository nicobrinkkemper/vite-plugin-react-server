  "typesVersions": {
    "*": {
      ".": [
        "./dist/plugin/index.d.ts"
      ],
      "client": [
        "./dist/plugin/react-client/index.d.ts"
      ],
      "server": [
        "./dist/plugin/react-server/plugin.d.ts"
      ],
      "static": [
        "./dist/plugin/react-static/index.d.ts"
      ],
