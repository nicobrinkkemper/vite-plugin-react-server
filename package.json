    "shiki": "^4.2.0",
    "source-map": "^0.7.4",
    "supports-color": "^10.0.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vitest": "^3.0.4",
    "webpack-sources": "^3.2.3"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "picocolors": "^1.1.1",
    "react-server-loader": "^19.2.11 || >=0.0.0-0 <0.0.1",
