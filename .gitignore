# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
scripts/.*
scripts/credentials.json
scripts/token.json
scripts/.oauthkey.json

# testing
/coverage

# production
/build
/docker-build
/dist

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

build.traditional.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

public/**/*
src/assets/**/*
scripts/data/*

# WSL
*.Zone.Identifier

# react oss (keep react-server-dom-esm for vendoring, ignore the rest)
/oss-experimental/*
!/oss-experimental/react-server-dom-esm
tsconfig.tsbuildinfo

# rollup cache
.rollup.cache

# test
test/fixtures/*
test/client/fixtures/*
test/server/fixtures/*
test/client/fixtures/*
test/unit/fixtures/*test-results/
playwright-report/
test-results/
*.tgz
docs-site/dist
